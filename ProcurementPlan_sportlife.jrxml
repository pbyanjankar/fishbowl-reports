	<queryString>
		<![CDATA[SELECT
 COMPANY.NAME AS COMPANY,
 locationgroup.name AS LGNAME
FROM
company
LEFT JOIN locationgroup ON locationgroup.id IN ($P!{locationGroupID})
WHERE company.id = 1]]>
	</queryString>

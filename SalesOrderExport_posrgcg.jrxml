		<parameterDescription><![CDATA[70,0]]></parameterDescription>
		<defaultValueExpression><![CDATA["70"]]></defaultValueExpression>
	</parameter>
	<parameter name="ckVoided" class="java.lang.String" isForPrompting="false">
		<property name="Tab" value="SO Status"/>
		<parameterDescription><![CDATA[80,0]]></parameterDescription>
		<defaultValueExpression><![CDATA["80"]]></defaultValueExpression>
	</parameter>
	<parameter name="ckCancelled" class="java.lang.String" isForPrompting="false">
		<property name="Tab" value="SO Status"/>
		<parameterDescription><![CDATA[85,0]]></parameterDescription>
		<defaultValueExpression><![CDATA["0"]]></defaultValueExpression>
	</parameter>
	<parameter name="ckExpired" class="java.lang.String" isForPrompting="false">
		<property name="Tab" value="SO Status"/>
		<parameterDescription><![CDATA[90,0]]></parameterDescription>
		<defaultValueExpression><![CDATA["90"]]></defaultValueExpression>
	</parameter>
	<parameter name="ShowReportHeader" class="java.lang.Boolean" isForPrompting="false">
		<property name="Tooltip" value="Check this box to show a timestamp in the footer"/>
		<defaultValueExpression><![CDATA[true]]></defaultValueExpression>
	</parameter>
	<parameter name="soNum" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["%"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT

COMPANY.NAME AS COMPANY,
CURRENCY.SYMBOL,
PRODUCT.NUM AS PRODUCTNUM,
PRODUCT.DESCRIPTION AS PRODUCTDESCRIPTION,
so.num AS SONUMBER,
SOITEM.UNITPRICE,
(SOITEM.UNITPRICE * SOITEM.QTYTOFULFILL) + SOITEM.ADJUSTAMOUNT AS SALES,
if(soitem.typeid = 20,SOITEM.QTYTOFULFILL * -1,SOITEM.QTYTOFULFILL) AS salesQty,
soitem.note AS NOTE

FROM SOItem
    JOIN Product ON Product.ID = SOItem.productID
    JOIN SO ON SO.ID = SOItem.SOID
    JOIN company ON company.id = 1
    LEFT JOIN currency ON currency.homeCurrency = 1
WHERE
  UPPER(so.num) LIKE UPPER($P{soNum})
  AND so.dateIssued BETWEEN $P{dateRange1} AND DATE_SUB($P{dateRange2}, INTERVAL 1 SECOND)
  AND soitem.typeid IN (10,11,12,$P{ckIncludeReturns},21,60,80)
  AND COALESCE(product.num,'') LIKE $P{productNum}
  AND so.statusid IN ($P{ckEstimate}, $P{ckIssued}, $P{ckInProgress}, $P{ckFulfilled}, $P{ckClosedShort}, $P{ckVoided}, $P{ckExpired}, $P{ckCancelled})

ORDER BY 3]]>
	</queryString>

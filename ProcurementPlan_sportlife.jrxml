		</parameter>
		<parameter name="locationGroupID" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT DISTINCT
    LOCATIONGROUP.NAME,
    PART.NUM AS PART,
    product.num AS PRODUCTNUMBER,
    UOM.CODE AS UOMCODE,
    COALESCE(LocLGQOH.qoh, 0) AS QTY,
    COALESCE(qtyAllocated.qty, 0) AS ALLOCATED,
    COALESCE(qtyonorder.qty, 0) AS ONORDER,
    COALESCE(qtynotavailable.qty,0) AS NOTAVAILABLE,
    COALESCE(qtyDropship.qty,0) AS DROPSHIP,
    PARTREORDER.REORDERPOINT AS REORDERPOINT,
    PARTREORDER.ORDERUPTOLEVEL AS ORDERUPTOLEVEL,
    PART.DESCRIPTION,
    VENDOR.NAME AS VENDOR,
    part.abccode,
    product.description AS PRODUCTDESCRIPTION,
    product.price AS PRODUCTPRICE,
    vendorparts.lastCost AS VENDORLASTCOST,


if(coalesce(soldYTD.QtySold,0)<0, 0, coalesce(soldYTD.QtySold,0)) AS SOLDATLG,
if(coalesce(soldAtOtherLG.QtySold,0)<0, 0, coalesce(soldAtOtherLG.QtySold,0)) AS SOLDATOTHERLG,
  DATE_FORMAT(CURDATE(), '%b %Y') AS CURRENTMONTH,
  DATE_FORMAT(CURDATE() - INTERVAL 1 MONTH, '%b %Y') AS `CURRENTMONTH-1`,
  DATE_FORMAT(CURDATE() - INTERVAL 2 MONTH, '%b %Y') AS `CURRENTMONTH-2`,
  DATE_FORMAT(CURDATE() - INTERVAL 3 MONTH, '%b %Y') AS `CURRENTMONTH-3`,
if(coalesce(previousMonthSold.QtySold,0)<0, 0, coalesce(previousMonthSold.QtySold,0)) AS `CURRENTMONTH-1SOLDATLG`,
if(coalesce(previousMonthSoldAtOtherLG.QtySold,0)<0, 0, coalesce(previousMonthSoldAtOtherLG.QtySold,0)) AS `CURRENTMONTH-1SOLDATOTHERLG`,

if(coalesce(CurrentMinus2MonthSold.QtySold,0)<0, 0, coalesce(CurrentMinus2MonthSold.QtySold,0)) AS `CURRENTMONTH-2SOLDATLG`,
if(coalesce(CurrentMinus2MonthSoldAtOtherLG.QtySold,0)<0, 0, coalesce(CurrentMinus2MonthSoldAtOtherLG.QtySold,0)) AS `CURRENTMONTH-2SOLDATOTHERLG`,

if(coalesce(CurrentMinus3MonthSold.QtySold,0)<0, 0, coalesce(CurrentMinus3MonthSold.QtySold,0)) AS `CURRENTMONTH-3SOLDATLG`,
if(coalesce(CurrentMinus3MonthSoldAtOtherLG.QtySold,0)<0, 0, coalesce(CurrentMinus3MonthSoldAtOtherLG.QtySold,0)) AS `CURRENTMONTH-3SOLDATOTHERLG`


FROM part
    LEFT JOIN product ON product.partId = part.id
    LEFT JOIN locationgroup ON locationgroup.id IN ($P!{locationGroupID})
    LEFT JOIN partreorder ON locationgroup.id = partreorder.locationgroupid AND part.id = partreorder.partid
    LEFT JOIN uom ON part.uomid = uom.id
    LEFT JOIN qtyonhand ON (part.id = qtyonhand.partid AND locationgroup.id = qtyonhand.locationgroupid)
    LEFT JOIN qtyallocated ON (part.id = qtyallocated.partid AND locationgroup.id = qtyallocated.locationgroupid)
    LEFT JOIN qtyonorder ON (part.id = qtyonorder.partid AND locationgroup.id = qtyonorder.locationgroupid)
    LEFT JOIN qtynotavailable ON (part.id = qtynotavailable.partid AND locationgroup.id = qtynotavailable.locationgroupid)
    LEFT JOIN qtydropship ON (part.id = qtydropship.partid AND locationgroup.id = qtydropship.locationgroupid)
    LEFT JOIN vendorparts ON part.id = vendorparts.partid AND vendorparts.defaultflag = 1
    LEFT JOIN vendor ON vendorparts.vendorid = vendor.id

-- Start OF SALES Current Month - CUSTOMER WITH same LG && Warehouse Zone 1

LEFT OUTER JOIN ( SELECT product.partid AS PartID,
		SUM(
		CASE WHEN soitem.typeid = 20
     		THEN -1 * ((soitem.qtyfulfilled  * COALESCE(UOMCONVERSION.MULTIPLY,1)) / COALESCE(UOMCONVERSION.FACTOR,1))
     		ELSE  ((soitem.qtyfulfilled * COALESCE(UOMCONVERSION.MULTIPLY,1)) / COALESCE(UOMCONVERSION.FACTOR,1))
		END) AS QtySold,
		so.locationgroupid AS LGID
                 FROM soitem
                 LEFT JOIN product ON soitem.productid = product.id
                 LEFT JOIN so ON so.id = soitem.soid
	       LEFT JOIN part ON product.partid = part.id
	       LEFT JOIN uomconversion ON (uomconversion.touomid = part.uomid AND uomconversion.fromuomid = soitem.uomid)
 	       LEFT JOIN customer ON customer.id = so.customerId
        	       LEFT OUTER JOIN qbclass ON qbclass.id = so.qbclassid
                WHERE soitem.qtyfulfilled > 0
                   AND soitem.datelastfulfillment >= DATE_FORMAT(CURDATE() - INTERVAL 0 MONTH, '%Y-%m-01')
  	         AND soitem.datelastfulfillment < DATE_FORMAT(CURDATE() - INTERVAL -1 MONTH, '%Y-%m-01')
	         AND qbclass.name = CustomFieldByName(customer.customfields, "Warehouse Zone 1")
                   AND CustomFieldByName(customer.customfields, "Warehouse Zone 1") LIKE (SELECT concat(locationgroup.name, " ", "Warehouse") FROM LocationGroup WHERE LocationGroup.id IN ($P!{locationGroupID}))
                GROUP BY product.partid
) AS soldYTD ON part.id = soldYTD.partid


-- END OF SALES Current Month - CUSTOMER WITH same LG && Warehouse Zone 1

-- START OF SALES Current Month - CUSTOMER WITH different LG && Warehouse Zone 1

LEFT OUTER JOIN ( SELECT product.partid AS PartID,
		SUM(
		CASE WHEN soitem.typeid = 20
     		THEN -1 * ((soitem.qtyfulfilled  * COALESCE(UOMCONVERSION.MULTIPLY,1)) / COALESCE(UOMCONVERSION.FACTOR,1))
     		ELSE  ((soitem.qtyfulfilled * COALESCE(UOMCONVERSION.MULTIPLY,1)) / COALESCE(UOMCONVERSION.FACTOR,1))
		END) AS QtySold
                 FROM soitem
                 LEFT JOIN product ON soitem.productid = product.id
                 LEFT JOIN so ON so.id = soitem.soid
	       LEFT JOIN part ON product.partid = part.id
	       LEFT JOIN uomconversion ON (uomconversion.touomid = part.uomid AND uomconversion.fromuomid = soitem.uomid)
	       LEFT JOIN customer ON customer.id = so.customerId
        	       LEFT OUTER JOIN qbclass ON qbclass.id = so.qbclassid
                WHERE soitem.qtyfulfilled > 0
                   AND soitem.datelastfulfillment >= DATE_FORMAT(CURDATE() - INTERVAL 0 MONTH, '%Y-%m-01')
  	         AND soitem.datelastfulfillment < DATE_FORMAT(CURDATE() - INTERVAL -1 MONTH, '%Y-%m-01')
	         AND qbclass.name <> CustomFieldByName(customer.customfields, "Warehouse Zone 1")
                   AND CustomFieldByName(customer.customfields, "Warehouse Zone 1") LIKE (SELECT concat(locationgroup.name, " ", "Warehouse") FROM LocationGroup WHERE LocationGroup.id IN ($P!{locationGroupID}))
                GROUP BY product.partid
) AS  soldAtOtherLG ON part.id = soldAtOtherLG.partid


-- END OF SALES Current Month - CUSTOMER WITH different LG && Warehouse Zone 1

-- Start OF SALES Previous Month - CUSTOMER WITH same LG && Warehouse Zone 1

LEFT OUTER JOIN ( SELECT product.partid AS PartID,
		SUM(
		CASE WHEN soitem.typeid = 20
     		THEN -1 * ((soitem.qtyfulfilled  * COALESCE(UOMCONVERSION.MULTIPLY,1)) / COALESCE(UOMCONVERSION.FACTOR,1))
     		ELSE  ((soitem.qtyfulfilled * COALESCE(UOMCONVERSION.MULTIPLY,1)) / COALESCE(UOMCONVERSION.FACTOR,1))
		END) AS QtySold,
		so.locationgroupid AS LGID
                 FROM soitem
                 LEFT JOIN product ON soitem.productid = product.id
                 LEFT JOIN so ON so.id = soitem.soid
	       LEFT JOIN part ON product.partid = part.id
	       LEFT JOIN uomconversion ON (uomconversion.touomid = part.uomid AND uomconversion.fromuomid = soitem.uomid)
 	       LEFT JOIN customer ON customer.id = so.customerId
        	       LEFT OUTER JOIN qbclass ON qbclass.id = so.qbclassid
                WHERE soitem.qtyfulfilled > 0
                   AND soitem.datelastfulfillment >= DATE_FORMAT(CURDATE() - INTERVAL 1 MONTH, '%Y-%m-01')
  	         AND soitem.datelastfulfillment < DATE_FORMAT(CURDATE() - INTERVAL 0 MONTH, '%Y-%m-01')
	         AND qbclass.name = CustomFieldByName(customer.customfields, "Warehouse Zone 1")
                   AND CustomFieldByName(customer.customfields, "Warehouse Zone 1") LIKE (SELECT concat(locationgroup.name, " ", "Warehouse") FROM LocationGroup WHERE LocationGroup.id IN ($P!{locationGroupID}))
                GROUP BY product.partid
) AS previousMonthSold ON part.id = previousMonthSold.partid


-- END OF SALES Previous Month - CUSTOMER WITH same LG && Warehouse Zone 1

-- START OF SALES Previous Month - CUSTOMER WITH different LG && Warehouse Zone 1

LEFT OUTER JOIN ( SELECT product.partid AS PartID,
		SUM(
		CASE WHEN soitem.typeid = 20
     		THEN -1 * ((soitem.qtyfulfilled  * COALESCE(UOMCONVERSION.MULTIPLY,1)) / COALESCE(UOMCONVERSION.FACTOR,1))
     		ELSE  ((soitem.qtyfulfilled * COALESCE(UOMCONVERSION.MULTIPLY,1)) / COALESCE(UOMCONVERSION.FACTOR,1))
		END) AS QtySold
                 FROM soitem
                 LEFT JOIN product ON soitem.productid = product.id
                 LEFT JOIN so ON so.id = soitem.soid
	       LEFT JOIN part ON product.partid = part.id
	       LEFT JOIN uomconversion ON (uomconversion.touomid = part.uomid AND uomconversion.fromuomid = soitem.uomid)
	       LEFT JOIN customer ON customer.id = so.customerId
        	       LEFT OUTER JOIN qbclass ON qbclass.id = so.qbclassid
                WHERE soitem.qtyfulfilled > 0
                   AND soitem.datelastfulfillment >= DATE_FORMAT(CURDATE() - INTERVAL 1 MONTH, '%Y-%m-01')
  	         AND soitem.datelastfulfillment < DATE_FORMAT(CURDATE() - INTERVAL 0 MONTH, '%Y-%m-01')
	         AND qbclass.name <> CustomFieldByName(customer.customfields, "Warehouse Zone 1")
                   AND CustomFieldByName(customer.customfields, "Warehouse Zone 1") LIKE (SELECT concat(locationgroup.name, " ", "Warehouse") FROM LocationGroup WHERE LocationGroup.id IN ($P!{locationGroupID}))
                GROUP BY product.partid
) AS  previousMonthSoldAtOtherLG ON part.id = previousMonthSoldAtOtherLG.partid


-- End OF SALES Previous Month - CUSTOMER WITH different LG && Warehouse Zone 1

-- Start OF SALES Current Month - 2  - CUSTOMER WITH same LG && Warehouse Zone 1

LEFT OUTER JOIN ( SELECT product.partid AS PartID,
		SUM(
		CASE WHEN soitem.typeid = 20
     		THEN -1 * ((soitem.qtyfulfilled  * COALESCE(UOMCONVERSION.MULTIPLY,1)) / COALESCE(UOMCONVERSION.FACTOR,1))
     		ELSE  ((soitem.qtyfulfilled * COALESCE(UOMCONVERSION.MULTIPLY,1)) / COALESCE(UOMCONVERSION.FACTOR,1))
		END) AS QtySold,
		so.locationgroupid AS LGID
                 FROM soitem
                 LEFT JOIN product ON soitem.productid = product.id
                 LEFT JOIN so ON so.id = soitem.soid
	       LEFT JOIN part ON product.partid = part.id
	       LEFT JOIN uomconversion ON (uomconversion.touomid = part.uomid AND uomconversion.fromuomid = soitem.uomid)
 	       LEFT JOIN customer ON customer.id = so.customerId
        	       LEFT OUTER JOIN qbclass ON qbclass.id = so.qbclassid
                WHERE soitem.qtyfulfilled > 0
                   AND soitem.datelastfulfillment >= DATE_FORMAT(CURDATE() - INTERVAL 2 MONTH, '%Y-%m-01')
  	         AND soitem.datelastfulfillment < DATE_FORMAT(CURDATE() - INTERVAL 1 MONTH, '%Y-%m-01')
	         AND qbclass.name = CustomFieldByName(customer.customfields, "Warehouse Zone 1")
                   AND CustomFieldByName(customer.customfields, "Warehouse Zone 1") LIKE (SELECT concat(locationgroup.name, " ", "Warehouse") FROM LocationGroup WHERE LocationGroup.id IN ($P!{locationGroupID}))
                GROUP BY product.partid
) AS CurrentMinus2MonthSold ON part.id = CurrentMinus2MonthSold.partid


-- END OF SALES CurrentMonthMinus2 Month - CUSTOMER WITH same LG && Warehouse Zone 1

-- START OF SALES CurrentMonthMinus2 Month - CUSTOMER WITH different LG && Warehouse Zone 1

LEFT OUTER JOIN ( SELECT product.partid AS PartID,
		SUM(
		CASE WHEN soitem.typeid = 20
     		THEN -1 * ((soitem.qtyfulfilled  * COALESCE(UOMCONVERSION.MULTIPLY,1)) / COALESCE(UOMCONVERSION.FACTOR,1))
     		ELSE  ((soitem.qtyfulfilled * COALESCE(UOMCONVERSION.MULTIPLY,1)) / COALESCE(UOMCONVERSION.FACTOR,1))
		END) AS QtySold
                 FROM soitem
                 LEFT JOIN product ON soitem.productid = product.id
                 LEFT JOIN so ON so.id = soitem.soid
	       LEFT JOIN part ON product.partid = part.id
	       LEFT JOIN uomconversion ON (uomconversion.touomid = part.uomid AND uomconversion.fromuomid = soitem.uomid)
	       LEFT JOIN customer ON customer.id = so.customerId
        	       LEFT OUTER JOIN qbclass ON qbclass.id = so.qbclassid
                WHERE soitem.qtyfulfilled > 0
                   AND soitem.datelastfulfillment >= DATE_FORMAT(CURDATE() - INTERVAL 2 MONTH, '%Y-%m-01')
  	         AND soitem.datelastfulfillment < DATE_FORMAT(CURDATE() - INTERVAL 1 MONTH, '%Y-%m-01')
	         AND qbclass.name <> CustomFieldByName(customer.customfields, "Warehouse Zone 1")
                   AND CustomFieldByName(customer.customfields, "Warehouse Zone 1") LIKE (SELECT concat(locationgroup.name, " ", "Warehouse") FROM LocationGroup WHERE LocationGroup.id IN ($P!{locationGroupID}))
                GROUP BY product.partid
) AS  CurrentMinus2MonthSoldAtOtherLG ON part.id = CurrentMinus2MonthSoldAtOtherLG.partid


-- Ens OF SALES Current Minus 2 Months - CUSTOMER WITH different LG && Warehouse Zone 1


-- Start OF SALES Current Minus 3 Months - CUSTOMER WITH same LG && Warehouse Zone 1

LEFT OUTER JOIN ( SELECT product.partid AS PartID,
		SUM(
		CASE WHEN soitem.typeid = 20
     		THEN -1 * ((soitem.qtyfulfilled  * COALESCE(UOMCONVERSION.MULTIPLY,1)) / COALESCE(UOMCONVERSION.FACTOR,1))
     		ELSE  ((soitem.qtyfulfilled * COALESCE(UOMCONVERSION.MULTIPLY,1)) / COALESCE(UOMCONVERSION.FACTOR,1))
		END) AS QtySold,
		so.locationgroupid AS LGID
                 FROM soitem
                 LEFT JOIN product ON soitem.productid = product.id
                 LEFT JOIN so ON so.id = soitem.soid
	       LEFT JOIN part ON product.partid = part.id
	       LEFT JOIN uomconversion ON (uomconversion.touomid = part.uomid AND uomconversion.fromuomid = soitem.uomid)
 	       LEFT JOIN customer ON customer.id = so.customerId
        	       LEFT OUTER JOIN qbclass ON qbclass.id = so.qbclassid
                WHERE soitem.qtyfulfilled > 0
                   AND soitem.datelastfulfillment >= DATE_FORMAT(CURDATE() - INTERVAL 3 MONTH, '%Y-%m-01')
  	         AND soitem.datelastfulfillment < DATE_FORMAT(CURDATE() - INTERVAL 2 MONTH, '%Y-%m-01')
	         AND qbclass.name = CustomFieldByName(customer.customfields, "Warehouse Zone 1")
                   AND CustomFieldByName(customer.customfields, "Warehouse Zone 1") LIKE (SELECT concat(locationgroup.name, " ", "Warehouse") FROM LocationGroup WHERE LocationGroup.id IN ($P!{locationGroupID}))
                GROUP BY product.partid
) AS CurrentMinus3MonthSold ON part.id = CurrentMinus3MonthSold.partid


-- END OF SALES Current Month Minus 3  - CUSTOMER WITH same LG && Warehouse Zone 1

-- START OF SALES Current Month Minus 3 - CUSTOMER WITH different LG && Warehouse Zone 1

LEFT OUTER JOIN ( SELECT product.partid AS PartID,
		SUM(
		CASE WHEN soitem.typeid = 20
     		THEN -1 * ((soitem.qtyfulfilled  * COALESCE(UOMCONVERSION.MULTIPLY,1)) / COALESCE(UOMCONVERSION.FACTOR,1))
     		ELSE  ((soitem.qtyfulfilled * COALESCE(UOMCONVERSION.MULTIPLY,1)) / COALESCE(UOMCONVERSION.FACTOR,1))
		END) AS QtySold
                 FROM soitem
                 LEFT JOIN product ON soitem.productid = product.id
                 LEFT JOIN so ON so.id = soitem.soid
	       LEFT JOIN part ON product.partid = part.id
	       LEFT JOIN uomconversion ON (uomconversion.touomid = part.uomid AND uomconversion.fromuomid = soitem.uomid)
	       LEFT JOIN customer ON customer.id = so.customerId
        	       LEFT OUTER JOIN qbclass ON qbclass.id = so.qbclassid
                WHERE soitem.qtyfulfilled > 0
                   AND soitem.datelastfulfillment >= DATE_FORMAT(CURDATE() - INTERVAL 3 MONTH, '%Y-%m-01')
  	         AND soitem.datelastfulfillment < DATE_FORMAT(CURDATE() - INTERVAL 2 MONTH, '%Y-%m-01')
	         AND qbclass.name <> CustomFieldByName(customer.customfields, "Warehouse Zone 1")
                   AND CustomFieldByName(customer.customfields, "Warehouse Zone 1") LIKE (SELECT concat(locationgroup.name, " ", "Warehouse") FROM LocationGroup WHERE LocationGroup.id IN ($P!{locationGroupID}))
                GROUP BY product.partid
) AS  CurrentMinus3MonthSoldAtOtherLG ON part.id = CurrentMinus3MonthSoldAtOtherLG.partid


-- End OF SALES Previous Month - CUSTOMER WITH different LG && Warehouse Zone 1


LEFT OUTER JOIN (SELECT
        			sum(tag.qty) AS qoh,
        			locationgroup.id AS lgid,
        			tag.partId AS partId
   		 FROM
       			 tag
		 INNER JOIN location ON tag.locationId=location.id AND (location.activeFlag = true OR location.pickable=true OR location.countedAsAvailable=true)
		 INNER JOIN locationgroup ON location.locationgroupid = locationgroup.id
		 WHERE
			tag.typeId in (30 , 40)
        		GROUP BY locationgroup.id, tag.partid) AS LocLGQOH ON LocLGQOH.partid = part.id AND LocLGQOH.lgid = locationgroup.id




WHERE part.id != 0
  AND part.num LIKE $P{partNum}
  AND part.activeflag IN (1,$P!{ckShowInactiveParts})
  AND (partreorder.locationgroupid IN ($P!{locationGroupID}) OR partreorder.locationgroupid IS NULL)

ORDER BY LOCATIONGROUP.NAME, $P!{cbOrderBy} $P!{cbSortOrder}, product.num;]]>
		</queryString>
